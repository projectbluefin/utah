# Hummingbird's own rebuilt packages. Every RPM here carries a hum disttag,
# and it takes precedence over Fedora via priority, which is how Hummingbird
# composes its own buildroot (mock/mock.cfg in redhat/hummingbird/containers).
[public-hummingbird-x86_64-rpms]
# utah-install: true
name=public-hummingbird-x86_64-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/x86_64/
enabled=1
sslverify=1
# Hummingbird's own repo file ships gpgcheck=0 so that their lockfile tooling
# fails loudly instead of silently on a bad signature. Their RPMs are signed
# (RSA/SHA256, key ID 199e2f91fd431d51, Red Hat release key 2), so an image
# build has no reason to skip the check. The key is committed as
# packages/RPM-GPG-KEY-redhat-release-2 (fingerprint 567E 347A D004 4ADE 55BA
# 8A5F 199E 2F91 FD43 1D51) and installed by the Containerfile.
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release-2
priority=10
zchunk=false
