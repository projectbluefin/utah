#!/usr/bin/bash
# Record the booted bootc image ref where unprivileged consumers (fastfetch's
# ublue-image-info.sh) can read it. `bootc status` requires root on bootc
# >= 1.14, so the live query is dead in user sessions, and the baked image tag
# is the compose-time tag. The booted ref cannot change within a boot, so one
# write per boot is always accurate. Parity with Dakota
# (projectbluefin/utah#675).
set -euo pipefail

bootc_json="$(bootc status --json 2>/dev/null || true)"
ref="$(jq -r '.status.booted.image.image.image // empty' <<<"${bootc_json}" 2>/dev/null || true)"
if [ -z "${ref}" ]; then
    echo "no booted bootc image found; leaving no state file" >&2
    exit 0
fi

install -d -m 0755 /run/ublue-os
tmp="$(mktemp /run/ublue-os/booted-image.XXXXXX)"
printf '%s\n' "${ref}" > "${tmp}"
chmod 0644 "${tmp}"
mv -f "${tmp}" /run/ublue-os/booted-image
