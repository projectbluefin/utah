#!/usr/bin/bash
# Record the booted bootc image ref where unprivileged consumers (Common's
# /usr/libexec/ublue-booted-image, used by fastfetch's ublue-image-info.sh)
# can read it. `bootc status` requires root on bootc >= 1.14, so the live
# query is dead in user sessions, and the baked image tag is the compose-time
# tag. The booted ref cannot change within a boot, so one write per boot is
# always accurate. Parity with Dakota (projectbluefin/utah#675).
#
# This script never runs bootc. ublue-booted-image.service runs `bootc status
# --json` as its own ExecStart, so bootc enters its SELinux domain instead of
# being denied mac_admin by its relabelling chcon probe (#1198), and writes the
# JSON this script reads.
set -euo pipefail

json="${1:-/run/ublue-os/booted-image.json}"
ref="$(jq -r '.status.booted.image.image.image // empty' "${json}" 2>/dev/null || true)"
if [ -z "${ref}" ]; then
    echo "no booted bootc image found in ${json}; leaving no state file" >&2
    exit 0
fi

install -d -m 0755 /run/ublue-os
tmp="$(mktemp /run/ublue-os/booted-image.XXXXXX)"
printf '%s\n' "${ref}" > "${tmp}"
chmod 0644 "${tmp}"
mv -f "${tmp}" /run/ublue-os/booted-image
