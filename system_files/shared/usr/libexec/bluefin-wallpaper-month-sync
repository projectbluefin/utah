#!/usr/bin/env bash
# Keep the Bluefin monthly wallpaper symlink pointed at the current month.
# Parity with Dakota (projectbluefin/utah#675): the gschema override points at
# the symlink below instead of a fixed month file, so the desktop background
# rotates without an image update.
set -euo pipefail

source_dir="/usr/share/backgrounds/bluefin"
state_dir="/var/lib/bluefin/backgrounds"
link_path="${state_dir}/current-bluefin.xml"
month_file="$(date +%m)-bluefin.xml"

if [[ ! -d "${source_dir}" ]]; then
    exit 0
fi

mkdir -p "${state_dir}"

if [[ -f "${source_dir}/${month_file}" ]]; then
    ln -sfn "${source_dir}/${month_file}" "${link_path}"
else
    ln -sfn "${source_dir}/12-bluefin.xml" "${link_path}"
fi
