# Utah is a graphical workstation, unlike the Hummingbird server base.
# Keep these in /usr/lib so bootc's first-boot preset application sees them.
enable gdm.service
enable bluetooth.service
# Match Bluefin discovery and hybrid-GPU defaults.
enable avahi-daemon.service
enable avahi-daemon.socket
enable switcheroo-control.service
enable firewalld.service
enable fwupd.service
enable fwupd-refresh.timer
enable tailscaled.service
enable uupd.timer
enable ublue-system-setup.service
enable systemd-resolved.service
# Keep the ESP boot manager current on systemd-boot systems (#363). A drop-in
# gates the service on a boot through systemd-boot, so GRUB and BIOS systems
# skip it and bootupd keeps managing their grub and shim.
enable systemd-boot-update.service
enable bootc-unified-storage.service
enable dconf-update.service
# First-boot Flatpaks (Bazaar, from common's preinstall.d). configure-services.sh
# enabled these at build time, but with no line here bootc's first-boot preset
# application turned them back off, and an image installed by anything but the
# ISO booted with no app store at all.
enable flatpak-preinstall.service
enable flatpak-nuke-fedora.service
enable bluefin-stats-refresh.timer
enable input-remapper.service
enable ModemManager.service
# Printing on demand, as Fedora's preset enables it for Bluefin.
enable cups.socket
enable cups.path
disable sshd.service
# The Hummingbird base's 90-systemd.preset enables getty@.service, and its
# kargs.d declares console=ttyS0, which is what makes systemd-getty-generator
# instantiate the serial login on a desktop box. Presets are read in
# lexicographic order and the first match wins, so this file outranks 90-*;
# configure-services.sh masks the unit as well. See #103.
disable serial-getty@ttyS0.service
disable rpm-ostree.service
disable bootc-fetch-apply-updates.timer
disable bootc-fetch-apply-updates.service
