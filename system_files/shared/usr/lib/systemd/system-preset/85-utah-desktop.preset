# Utah is a graphical workstation, unlike the Hummingbird server base.
# Keep these in /usr/lib so bootc's first-boot preset application sees them.
enable gdm.service
enable bluetooth.service
# GNOME's system services, as Dakota inherits them from gnome-build-meta's
# files/systemd-presets/system-preset/80-gnome.preset: colour management and
# the AccountsService daemon Settings and GDM use to manage users.
enable colord.service
enable accounts-daemon.service
# Match Bluefin discovery and hybrid-GPU defaults.
enable avahi-daemon.service
enable avahi-daemon.socket
enable switcheroo-control.service
enable firewalld.service
enable fwupd.service
enable fwupd-refresh.timer
enable tailscaled.service
enable uupd.timer
enable projectbluefin-countme.timer
enable bluefin-stats-refresh.timer
enable ublue-system-setup.service
enable systemd-resolved.service
# Keep the ESP boot manager current on systemd-boot systems (#363). A drop-in
# gates the service on a boot through systemd-boot, so GRUB and BIOS systems
# skip it and bootupd keeps managing their grub and shim.
enable systemd-boot-update.service
enable bootc-unified-storage.timer
enable dconf-update.service
# Dakota desktop parity (#675): first-boot install-date stamping and the
# booted-image snapshot fastfetch reads. Wallpaper rotation stays with
# Common's per-user timer (see configure-services.sh).
# configure-services.sh enables these at build time; the preset lines keep
# bootc's first-boot preset application from undoing that (see #98).
enable ublue-firstboot-date.service
enable ublue-booted-image.service
# First-boot Flatpaks (Bazaar, the Files previewer, and Ghostty from TunaOS).
# configure-services.sh enabled these at build time, but with no line here
# bootc's first-boot preset application turned them back off, and an image
# installed by anything but the ISO booted with no app store at all.
enable flatpak-preinstall.service
enable flatpak-nuke-fedora.service
enable input-remapper.service
enable ModemManager.service
# Power profiles and thermal management as Dakota ships them (#388):
# power-profiles-daemon backs GNOME's power-mode switch and thermald handles
# thermal limits. Utah ships neither TuneD/tuned-ppd nor intel_lpmd.
# Hummingbird's 99-default-disable would leave both off.
enable power-profiles-daemon.service
enable thermald.service
# System activity accounting is opt-in, as in Dakota
# (elements/bluefin/sysstat.bst writes 80-sysstat.preset disabling all four):
# sar/iostat/mpstat/pidstat work on demand without the collectors. Enable with
# `systemctl enable --now sysstat.service`. Listed explicitly, as Dakota does,
# rather than left to Hummingbird's 99-default-disable.
disable sysstat.service
disable sysstat-collect.timer
disable sysstat-summary.timer
disable sysstat-rotate.timer
# nfs-client.target is enabled by both Fedora's and Hummingbird's 90-default
# preset, and is turned off here on purpose. Installing nfs-common-utils (#263)
# made it start gssproxy.service (target -> auth-rpcgss-module.service ->
# gssproxy.service), which failed every boot in the review VM with
# status=238/STATE_DIRECTORY, Permission denied creating /var/lib/gssproxy
# (cause not diagnosed). mount.nfs starts rpc-statd on demand, so NFS mounts do
# not need the target.
disable nfs-client.target
# Printing on demand, as Fedora's preset enables it for Bluefin.
enable cups.socket
enable cups.path
disable sshd.service
# The Hummingbird base's 90-systemd.preset enables getty@.service, and its
# kargs.d declares console=ttyS0, which is what makes systemd-getty-generator
# instantiate the serial login on a desktop box. Presets are read in
# lexicographic order and the first match wins, so this file outranks 90-*;
# configure-services.sh masks the unit as well. See #103.
disable serial-getty@ttyS0.service
disable rpm-ostree.service
disable bootc-fetch-apply-updates.timer
disable bootc-fetch-apply-updates.service
