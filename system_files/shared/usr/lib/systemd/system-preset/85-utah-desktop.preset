# Utah is a graphical workstation, unlike the Hummingbird server base.
# Keep these in /usr/lib so bootc's first-boot preset application sees them.
enable gdm.service
enable bluetooth.service
enable firewalld.service
enable fwupd.service
enable fwupd-refresh.timer
enable tailscaled.service
enable uupd.timer
enable ublue-system-setup.service
enable systemd-resolved.service
enable bootc-unified-storage.service
enable dconf-update.service
# Desktop hardware units. These must be listed here and not only enabled in
# configure-services.sh: bootc applies presets on first boot, so a build-time
# enablement with no preset line behind it gets undone. That is the trap the
# sshd branch of configure-services.sh already documents, and #98 confirmed
# the symptom from the other side -- grepping the deployed image found no
# preset enabling bluetooth.service anywhere. bluetooth.service itself is
# added by #125, with its desktop-contract entry.
enable input-remapper.service
disable sshd.service
disable rpm-ostree.service
