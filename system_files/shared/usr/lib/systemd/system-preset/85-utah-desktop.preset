# Where Utah's desktop disagrees with the Hummingbird server base.
# Presets are read in lexical order and the first matching line wins, so this
# file outranks Hummingbird's 80-hummingbird.preset, 90-default.preset and
# 90-systemd.preset. Everything else follows 98-utah-enable-default.preset
# (#1233): enabled unless a preset turns it off, as on Dakota. Keep this file to
# the units the base names; a desktop unit the base does not mention needs no
# line here.

# Keep the ESP boot manager current on systemd-boot systems (#363). A drop-in
# gates the service on a boot through systemd-boot, so GRUB and BIOS systems
# skip it and bootupd keeps managing their grub and shim. Hummingbird's
# 90-default.preset disables it.
enable systemd-boot-update.service

# Time sync is systemd-timesyncd, as on GNOME OS and Dakota (#1228); chrony is
# not installed. Hummingbird's 90-default.preset disables timesyncd in favour
# of chronyd. ublue-firstboot-date.path waits for its first sync.
enable systemd-timesyncd.service
disable chronyd.service

# Hummingbird's 90-default.preset enables these server units; Dakota does not
# run them. No multipath on a desktop; lm_sensors is Dakota's
# 80-lm-sensors.preset.
disable multipathd.service
disable lm_sensors.service
# Dakota's 50-iscsi.preset. Hummingbird's 90-default.preset enables the
# initiator sockets, so the disables have to come before it.
disable iscsi-init.service
disable iscsi.service
disable iscsid.service
disable iscsid.socket
disable iscsiuio.service
disable iscsiuio.socket
disable isnsd.service
disable isnsd.socket
# GNOME OS's openssh.preset; Hummingbird's 90-default.preset enables sshd.
# configure-services.sh flips this line for an ENABLE_SSHD=1 debug build.
disable sshd.service
# The Hummingbird base's 90-systemd.preset enables getty@.service, and its
# kargs.d declares console=ttyS0, which is what makes systemd-getty-generator
# instantiate the serial login on a desktop box. configure-services.sh masks
# the unit as well. See #103.
disable serial-getty@ttyS0.service
# Image updates go through uupd and bootc; configure-services.sh masks the
# bootc timer too.
disable rpm-ostree.service
disable bootc-fetch-apply-updates.timer
disable bootc-fetch-apply-updates.service
