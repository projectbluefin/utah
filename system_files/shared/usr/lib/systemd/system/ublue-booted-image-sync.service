[Unit]
Description=Record booted bootc image ref for unprivileged consumers
Documentation=https://github.com/projectbluefin/utah/issues/675
Documentation=https://github.com/projectbluefin/utah/issues/1198
Requires=ublue-booted-image.service
After=ublue-booted-image.service
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Parses the JSON ublue-booted-image.service wrote. Kept in its own unit, with
# no StandardOutput= override, so nothing reopens and truncates that file.
ExecStart=/usr/bin/ublue-booted-image-sync /run/ublue-os/booted-image.json

[Install]
WantedBy=multi-user.target
