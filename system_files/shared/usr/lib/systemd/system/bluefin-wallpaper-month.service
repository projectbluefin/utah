[Unit]
Description=Update Bluefin wallpaper month symlink
Documentation=https://github.com/projectbluefin/utah/issues/675
After=local-fs.target
ConditionPathExists=/usr/share/backgrounds/bluefin
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/bluefin-wallpaper-month-sync

[Install]
WantedBy=multi-user.target
