[Unit]
Description=Refresh Bluefin community stats for fastfetch
Documentation=https://projectbluefin.io
After=network-online.target
Wants=network-online.target
ConditionPathIsReadWrite=/var/cache

[Service]
Type=oneshot
ExecStart=/usr/libexec/bluefin-refresh-stats
StandardOutput=journal
StandardError=journal
# The job needs the network and a writable /var/cache/bluefin, nothing else.
# CacheDirectory replaces the ExecStartPre mkdir and owns the directory for
# the dynamic user; the files it writes stay world-readable for fastfetch.
DynamicUser=yes
CacheDirectory=bluefin
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
