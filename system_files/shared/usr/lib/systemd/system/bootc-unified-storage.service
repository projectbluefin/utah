# bootc unified storage onboarding — experimental
#
# Onboards this system to bootc-owned containers-storage (/usr/lib/bootc/storage)
# so that future upgrades use the unified pull path: zstd:chunked deduplication,
# shared layer storage between bootc and podman, and efficient partial chunk pulls.
#
# This is a network operation. `bootc image set-unified` pulls the booted image
# from its registry into bootc storage -- the whole image, about 2.3 GB of
# layers for Utah -- before re-importing it. On a booted
# testing-20261001-41873b5 that took 77 seconds on a datacenter link.
#
# It must not run during boot. bootc-unified-storage.timer starts it 15
# minutes after boot instead. As a unit wanted by multi-user.target it first
# held multi-user.target and graphical.target for the whole pull
# (graphical.target at 1min 32s, 82s of it this unit). With
# DefaultDependencies=no it no longer held the targets, but the pull still ran
# from 11s to 77s of first boot, and Nice=19 with IOSchedulingClass=idle did
# not stop it starving the session coming up: geoclue never took its bus name
# and hit its start timeout, gnome-shell's PowerProfiles call timed out, and
# TuneD waited on the ostree sysroot lock the pull holds. Nothing waits on
# unified storage; only the next upgrade uses it. No [Install] section: the
# timer is the only thing that starts it.
#
# ExecStart must stay the bare bootc binary. Its install_exec_t label is the
# entrypoint into bootc's SELinux domain; wrapped in `sh -c` it ran as
# initrc_t, and its relabelling chcon calls were denied mac_admin.
#
# Runs once: ExecStartPost writes the sentinel, and for a oneshot that only
# happens after ExecStart succeeded. On failure (offline, registry unreachable)
# it retries every 15 minutes in the background; a 60 second retry re-attempted
# a multi-GB pull every minute.
#
# Feature status in bootc upstream: experimental
# Tracking: https://github.com/bootc-dev/bootc/issues/20
[Unit]
Description=Enable bootc unified storage (experimental)
Documentation=https://containers.github.io/bootc/experimental-unified-storage.html
ConditionPathExists=/run/ostree-booted
ConditionPathExists=!/var/lib/.bootc-unified-storage
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target basic.target local-fs.target network-online.target
Wants=network-online.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=bootc image set-unified
ExecStartPost=touch /var/lib/.bootc-unified-storage
RemainAfterExit=yes
Restart=on-failure
RestartSec=15min
Nice=19
IOSchedulingClass=idle
