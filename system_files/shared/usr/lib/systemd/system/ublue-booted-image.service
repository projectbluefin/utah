[Unit]
Description=Snapshot bootc status for the booted-image record
Documentation=https://github.com/projectbluefin/utah/issues/675
Documentation=https://github.com/projectbluefin/utah/issues/1198
ConditionPathExists=/usr/bin/bootc
After=local-fs.target systemd-tmpfiles-setup.service
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
# ExecStart must stay the bare bootc binary: its install_exec_t label is the
# entrypoint into bootc's SELinux domain. Run from a script in the unconfined
# service domain, bootc's relabelling chcon probe was denied mac_admin,
# logging two AVC denials every boot (#1198).
ExecStart=/usr/bin/bootc status --json
# No ExecStartPre= or ExecStartPost= here: systemd opens this output for every
# command the unit runs, so a second command would truncate the JSON, or fail
# before creating a directory it needs. tmpfiles.d creates /run/ublue-os, and
# ublue-booted-image-sync.service parses the JSON afterwards.
StandardOutput=truncate:/run/ublue-os/booted-image.json

[Install]
WantedBy=multi-user.target
