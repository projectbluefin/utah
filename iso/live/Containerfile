# Utah live ISO environment.
# The live image is a disposable overlay around a normal Utah bootc image.
# The host-side builder supplies the source image as an OCI ref.
ARG SOURCE_IMAGE=localhost/utah:testing
FROM ${SOURCE_IMAGE}

# TARGET_IMAGE is the published image name recorded in the installer recipe
# and embedded offline store. SOURCE_IMAGE may be localhost for development;
# it must never leak into the released recipe.
ARG TARGET_IMAGE=ghcr.io/projectbluefin/utah:testing
ARG DEBUG=0
ENV TARGET_IMAGE=${TARGET_IMAGE} DEBUG=${DEBUG}

# Utah already carries dracut-live; systemd-boot is added only to the live
# environment because the installed image uses the Hummingbird bootloader.
#
# dbus-daemon is for the build itself: install-flatpaks.sh starts a system bus
# so flatpak can install into /var/lib, and Utah carries dbus-broker rather
# than the reference daemon, so /usr/bin/dbus-daemon is not there. The package
# is small and never leaves the live overlay.
RUN dnf5 install -y --setopt=install_weak_deps=False \
        systemd-boot-unsigned dbus-daemon && \
    dnf5 clean all && rm -rf /var/cache/dnf /var/cache/libdnf5

# Bake the installer plus precisely the Flatpaks declared by the Bluefin
# Brewfile into the squashfs. The cache is only a build accelerator; /var/lib
# is committed into the live image and copied to the installed target offline.
COPY src/install-flatpaks.sh /usr/local/libexec/utah-install-live-flatpaks
RUN --mount=type=cache,target=/var/cache/flatpak-dl,id=utah-flatpak \
    awk -F '"' '/^flatpak / {print $2}' /usr/share/ublue-os/homebrew/system-flatpaks.Brewfile > /tmp/flatpaks-list && \
    chmod 0755 /usr/local/libexec/utah-install-live-flatpaks && \
    /usr/local/libexec/utah-install-live-flatpaks

COPY src/ /tmp/utah-live-src/
RUN chmod 0755 /tmp/utah-live-src/configure-live.sh && \
    /tmp/utah-live-src/configure-live.sh

# Rebuild against Utah's own kernel and userspace.
#
# /root is a symlink to /var/roothome in bootc images, but /var/roothome does
# not exist at container build time, causing dracut-install to fail copying it.
# We create /var/roothome so dracut-install can resolve the symlink target.
#
# In container build contexts, syslog logging is disabled via sysloglvl=0 so
# dracut does not emit /dev/log errors.
#
# dracut is run with --stdlog 4 and output is monitored so any logged error
# (dracut[E]) immediately fails the live initramfs build step.
#
# tpm2-tss and pcsc are omitted because they cannot be satisfied. Hummingbird's
# dracut config adds "fido2 tpm2-tss pkcs11 pcsc" unconditionally, and a module
# named there is an error rather than a skip when its helpers are missing:
# tpm2-tss wants tpm2_pcrread from tpm2-tools and pcsc wants the pcsc-lite
# tools, and neither package exists in Hummingbird or in this factory.
#
# Dropping them costs nothing here. This is the live initramfs, which boots an
# unencrypted squashfs from the ISO and has no smartcard or TPM-backed volume
# to open; the installed system boots the payload image's own initramfs, which
# this build never touches. Revisit if Utah ever wants TPM-bound LUKS, which
# needs tpm2-tools in the installed image, not in the live overlay.
RUN set -eoux pipefail; \
    kernel="$(ls /usr/lib/modules | sort -V | tail -1)"; \
    mkdir -m 0700 -p /var/roothome; \
    mkdir -p /etc/dracut.conf.d; \
    printf 'sysloglvl=0\n' > /etc/dracut.conf.d/00-no-syslog.conf; \
    dracut --force --reproducible --no-hostonly --stdlog 4 \
      --add dmsquash-live \
      --omit 'tpm2-tss pcsc' \
      --add-drivers 'squashfs overlay loop iso9660 sr_mod cdrom' \
      "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}" 2>&1 | tee /tmp/dracut.log; \
    if grep -q 'dracut\[E\]' /tmp/dracut.log; then \
      echo "dracut reported errors during live initramfs generation" >&2; \
      exit 1; \
    fi; \
    rm -f /tmp/dracut.log /etc/dracut.conf.d/00-no-syslog.conf
