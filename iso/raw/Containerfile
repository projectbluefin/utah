# Experimental image-based installer (docs/adr/0001-image-based-installer.md):
# a Utah image whose installed disk can also boot as live media.
#
# The shipped bootc disk image is the live medium (booted with `ro utah.live`:
# an initrd tmpfs overlay over the root), and installing is a block copy of
# it, done by OS-Installer's Utah config (hanthor/os-installer, utah_config/).
# The layers sit on top of a published Utah digest; the published image and
# the ISO/fisherman path are unchanged.
ARG SOURCE_IMAGE=ghcr.io/projectbluefin/utah:testing@sha256:1c7956e2bce78117e8708f56ef64899fd11827f22adf30f3b7f27379fecd872f
ARG BUILDER_IMAGE=registry.fedoraproject.org/fedora:43@sha256:a19e8544313a675e6529d3242f74f0015beebdd1834d0bf9b132e669f734f2bf

# OS-Installer is Python + GTK4/libadwaita; every runtime library it loads is
# already in Utah (gnome-desktop4, libgweather4, vte291-gtk4, udisks2, Atspi).
# Only blueprint-compiler, needed to build its .ui files, is missing from the
# Hummingbird repositories, so build it here and copy the result over.
FROM ${BUILDER_IMAGE} AS os-installer
ARG OSI_REPO=https://github.com/hanthor/os-installer.git
# Full commit of hanthor/os-installer (branch utah). Fetched by commit and
# compared after checkout, so the build never follows a moving branch.
ARG OSI_REF=20064186ffba96f3ee73114f84feed9404f742ec
RUN dnf -y install --setopt=install_weak_deps=False \
        git meson ninja-build gettext blueprint-compiler glib2-devel \
        gtk4-devel libadwaita-devel gnome-desktop4-devel libgweather4-devel \
        vte291-gtk4-devel python3-pyyaml desktop-file-utils && \
    [[ "${OSI_REF}" =~ ^[0-9a-f]{40}$ ]] && \
    git init -q /src && \
    git -C /src fetch -q --depth 1 "${OSI_REPO}" "${OSI_REF}" && \
    git -C /src checkout -q FETCH_HEAD && \
    test "$(git -C /src rev-parse HEAD)" = "${OSI_REF}" && \
    meson setup /src/build /src --prefix=/usr && \
    meson install -C /src/build --destdir /out && \
    install -d /out/usr/share/utah && \
    cp -a /src/utah_config /out/usr/share/utah/os-installer && \
    mv /out/usr/share/applications/com.github.p3732.os_installer.desktop \
       /out/usr/share/utah/os-installer/ && \
    echo "${OSI_REF}" > /out/usr/share/utah/os-installer/SOURCE_REF

FROM ${SOURCE_IMAGE}
COPY --from=os-installer /out/usr/ /usr/
COPY src/usr/ /usr/

# python3-pyyaml is OS-Installer's only runtime dependency Utah lacks.
# Then rebuild the initramfs with the utah.live root overlay unit and its
# ordering before the ostree and the composefs (bootc-root-setup) root setup
# (dracut.conf.d/60-utah-live.conf), using the same dracut invocation as
# scripts/regenerate-initramfs.sh. /boot ends up empty: bootc's composefs
# backend refuses an image with Type #1 entries there ("Found Type1 entries
# in /boot"). scripts/clean-stage.sh empties it in images built since #1131;
# older digests (the comparison's 1c7956e2 among them) still carry
# kernel-install's entry, and the ostree backend never reads the image's /boot.
RUN set -euxo pipefail; \
    find /boot -mindepth 1 -delete; \
    dnf5 install -y --setopt=install_weak_deps=False python3-pyyaml; \
    dnf5 clean all; rm -rf /var/cache/dnf /var/cache/libdnf5 /var/log/dnf5.log*; \
    glib-compile-schemas /usr/share/glib-2.0/schemas; \
    chmod 0755 /usr/libexec/utah-live-setup /usr/share/utah/os-installer/scripts/install.sh; \
    systemctl enable utah-live-setup.service utah-live-ready.service; \
    kver="$(ls /usr/lib/modules | sort -V | tail -1)"; \
    mkdir -p /var/roothome; \
    dracut --no-hostonly --reproducible --zstd --tmpdir /tmp --kver "${kver}" --force \
        "/usr/lib/modules/${kver}/initramfs.img" 2>&1 | tee /tmp/dracut.log; \
    if grep -q 'dracut\[E\]: FAILED' /tmp/dracut.log; then exit 1; fi; \
    rm -f /tmp/dracut.log; rmdir /var/roothome 2>/dev/null || true; \
    listing="$(lsinitrd "/usr/lib/modules/${kver}/initramfs.img")"; \
    for f in usr/lib/systemd/systemd-volatile-root \
             usr/lib/systemd/system/utah-live-root.service \
             usr/lib/systemd/system/ostree-prepare-root.service.d/10-utah-live.conf \
             usr/lib/systemd/system/bootc-root-setup.service.d/10-utah-live.conf \
             usr/lib/systemd/system/bootc-root-setup.service \
             usr/lib/bootc/initramfs-setup; do \
        grep -q " ${f}\$" <<<"${listing}"; \
    done; \
    python3 -c 'import yaml, gi; gi.require_version("Vte", "3.91"); gi.require_version("GnomeDesktop", "4.0"); gi.require_version("GWeather", "4.0"); gi.require_version("UDisks", "2.0"); from gi.repository import Vte, GnomeDesktop, GWeather, UDisks'
