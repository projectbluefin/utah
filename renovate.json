{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/",
        "/^packages/utah-packages\\.repo$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)(?:ARG PACKAGE_IMAGE_SHA=|# factory-pin: )(?<currentDigest>sha256:[a-f0-9]{64})(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "ghcr.io/projectbluefin/utah-packages",
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(post-testing-e2e|execute-release|candidate-common)\\.yml$/"
      ],
      "matchStrings": [
        "\\s(?:gate_)?test_ref: (?<currentDigest>[0-9a-f]{40}) # (?<currentValue>v1)\\s"
      ],
      "depNameTemplate": "projectbluefin/testsuite",
      "packageNameTemplate": "https://github.com/projectbluefin/testsuite",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "ghcr.io/projectbluefin/utah-packages"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "utah package factory",
      "automerge": false
    },
    {
      "matchDepNames": [
        "projectbluefin/testsuite"
      ],
      "groupName": "projectbluefin/testsuite"
    },
    {
      "description": "Red Hat Hardened Images pins (registry.access.redhat.com/hi), extracted from Containerfile ARGs by the built-in Dockerfile manager. They rebuild daily; take the digest weekly.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.access.redhat.com/hi/**"
      ],
      "groupName": "Red Hat Hardened Images",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "These 11 workflows are human-merge paths in the hive (they build, test, release or publish, or hold the App key). Give their updates their own branches, so a pin-only update to them is a PR of its own that the hive's pin-only exception can merge, instead of being held with other workflows. Renovate doesn't merge these updates itself, because its own merge would skip the hive's hold on these files. The hive merges a pin-only update (including the projectbluefin/testsuite test_ref lines that move with their uses: pin), and anything else, a major included, waits for a person. Keep this list equal to the hive's human_merge_paths for utah.",
      "matchFileNames": [
        ".github/workflows/build.yml",
        ".github/workflows/execute-release.yml",
        ".github/workflows/promote-testing-to-main.yml",
        ".github/workflows/post-testing-e2e.yml",
        ".github/workflows/sync-main-to-testing.yml",
        ".github/workflows/image-baselines.yml",
        ".github/workflows/update-armed-prs.yml",
        ".github/workflows/update-gnome-extensions.yml",
        ".github/workflows/prow.yml",
        ".github/workflows/candidate-common.yml",
        ".github/workflows/pages.yml"
      ],
      "additionalBranchPrefix": "human-merge-paths-",
      "automerge": false
    }
  ]
}
